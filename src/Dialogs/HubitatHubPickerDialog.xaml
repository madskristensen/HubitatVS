<platformUI:DialogWindow
    x:Class="HubitatVS.HubitatHubPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    Title="Select Hubitat Connection"
    ResizeMode="NoResize"
    Width="300" Height="250"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <Grid Margin="12" toolkit:Themes.UseVsTheme="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose which Hubitat connection to publish to:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <ListBox x:Name="HubListBox"
                 Grid.Row="1"
                 DisplayMemberPath="Name"
                 SelectionMode="Single"
                 MouseDoubleClick="HubListBox_MouseDoubleClick"/>

        <CheckBox x:Name="DontAskCheckBox"
                  Grid.Row="2"
                  Content="Don't ask me again this session"
                  Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="OK" Width="75" Margin="0,0,8,0" IsDefault="True" Click="OK_Click"/>
            <Button Content="Cancel" Width="75" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</platformUI:DialogWindow>
