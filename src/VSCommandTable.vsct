<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h"/>
	<Extern href="vsshlids.h"/>
	<Include href="VSGlobals.vsct"/>

	<Commands package="HubitatVS">
		<Groups>
			<Group guid="HubitatVS" id="HubitatMenuGroup" priority="0x0600">
				<Parent guid="VSMainMenu" id="Tools"/>
			</Group>
			<Group guid="HubitatVS" id="HubitatWorkspaceContextMenuGroup" priority="0x0100">
				<Parent guid="guidWorkspaceExplorerToolWindowPackageCmdSet" id="idmWSE_ContextMenu"/>
			</Group>
		</Groups>

		<Bitmaps>
			<Bitmap guid="Icons" href="Resources\Icons\logo.16.16.png" usedList="Logo"/>
		</Bitmaps>

		<Buttons>
			<Button guid="HubitatVS" id="ShowHubitatConnectionsToolWindowCommand" priority="0x0100" type="Button">
				<Parent guid="VSMainMenu" id="Tools.ExternalToolsGroup" />
				<Icon guid="Icons" id="Logo" />
				<Strings>
					<ButtonText>Hubitat Connections...</ButtonText>
					<LocCanonicalName>.HubitatVS.ShowHubitatConnectionsToolWindowCommand</LocCanonicalName>
				</Strings>
			</Button>
      
			<Button guid="HubitatVS" id="PublishToHubitatCommand" priority="0x0100" type="Button">
				<Parent guid="HubitatVS" id="HubitatWorkspaceContextMenuGroup"/>
				<Icon guid="Icons" id="Logo" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>Publish to Hubitat...</ButtonText>
					<LocCanonicalName>.HubitatVS.PublishToHubitatCommand</LocCanonicalName>
				</Strings>
			</Button>
		</Buttons>
		</Commands>

		<CommandPlacements>
			<CommandPlacement guid="HubitatVS" id="PublishToHubitatCommand" priority="0x0100">
				<Parent guid="VSMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
			</CommandPlacement>
		</CommandPlacements>

		<KeyBindings>
			<KeyBinding guid="HubitatVS" id="PublishToHubitatCommand" editor="guidVSStd97" key1="1" mod1="Alt" />
		</KeyBindings>

		<Symbols>
		<GuidSymbol name="HubitatVS" value="{0899a45c-32a0-48cb-8627-4af2e2976fc3}">
			<IDSymbol name="HubitatMenuGroup" value="0x0001" />
			<IDSymbol name="HubitatWorkspaceContextMenuGroup" value="0x0002" />
			<IDSymbol name="ShowHubitatConnectionsToolWindowCommand" value="0x0102" />
			<IDSymbol name="PublishToHubitatCommand" value="0x0103" />
		</GuidSymbol>

		<GuidSymbol name="guidWorkspaceExplorerToolWindowPackageCmdSet" value="{cfb400f1-5c60-4f3c-856e-180d28def0b7}">
			<IDSymbol name="idmWSE_ContextMenu" value="0x0002"/>
		</GuidSymbol>

		<GuidSymbol name="Icons" value="{3b6d4b18-2382-4761-b792-00ea3526509b}">
			<IDSymbol name="Logo" value="1"/>
		</GuidSymbol>
	</Symbols>
</CommandTable>
