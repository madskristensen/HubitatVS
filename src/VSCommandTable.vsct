<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="VSGlobals.vsct"/>
  <Include href="KnownImageIds.vsct"/>

  <Commands package="HubitatVS">
    <Menus>
      <Menu guid="HubitatVS" id="HubitatContextMenuFlyout" priority="0x0100" type="Menu">
        <Parent guid="HubitatVS" id="HubitatWorkspaceContextMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Hubitat</ButtonText>
          <CommandName>Hubitat</CommandName>
        </Strings>
      </Menu>
      <Menu guid="HubitatVS" id="HubitatAdornmentContextMenu" type="Context">
        <Strings>
          <CommandName>HubitatAdornmentContextMenu</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="HubitatVS" id="HubitatMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="Tools"/>
      </Group>
      <Group guid="HubitatVS" id="HubitatWorkspaceContextMenuGroup" priority="0x0100">
        <Parent guid="guidWorkspaceExplorerToolWindowPackageCmdSet" id="idmWSE_ContextMenu"/>
      </Group>
      <Group guid="HubitatVS" id="HubitatAdornmentContextMenuGroup" priority="0x0100">
        <Parent guid="HubitatVS" id="HubitatAdornmentContextMenu"/>
      </Group>
      <Group guid="HubitatVS" id="HubitatAdornmentCompareGroup" priority="0x0200">
        <Parent guid="HubitatVS" id="HubitatAdornmentContextMenu"/>
      </Group>
    </Groups>

    <Bitmaps>
      <Bitmap guid="Icons" href="Resources\Icons\logo.16.16.png" usedList="Logo"/>
    </Bitmaps>

    <Buttons>
      <Button guid="HubitatVS" id="ShowHubitatConnectionsToolWindowCommand" priority="0x0100" type="Button">
        <Parent guid="VSMainMenu" id="Tools.ExternalToolsGroup" />
        <Icon guid="Icons" id="Logo" />
        <Strings>
          <ButtonText>Hubitat Connections</ButtonText>
          <LocCanonicalName>.HubitatVS.ShowHubitatConnectionsToolWindowCommand</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="HubitatVS" id="PublishToHubitatCommand" priority="0x0100" type="Button">
        <Parent guid="HubitatVS" id="HubitatAdornmentContextMenuGroup"/>
        <Icon guid="Icons" id="Logo" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Publish to Hubitat</ButtonText>
          <LocCanonicalName>.HubitatVS.PublishToHubitatCommand</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="HubitatVS" id="CompareWithHubCommand" priority="0x0100" type="Button">
        <Parent guid="HubitatVS" id="HubitatAdornmentCompareGroup"/>
        <Icon guid="ImageCatalogGuid" id="CompareFiles"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Compare with hub version</ButtonText>
          <LocCanonicalName>.HubitatVS.CompareWithHubCommand</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="HubitatVS" id="ReplaceWithHubVersionCommand" priority="0x0200" type="Button">
        <Parent guid="HubitatVS" id="HubitatAdornmentCompareGroup"/>
        <Icon guid="ImageCatalogGuid" id="Download"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Replace with hub version</ButtonText>
          <LocCanonicalName>.HubitatVS.ReplaceWithHubVersionCommand</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="HubitatVS" id="TogglePublishOnSaveCommand" priority="0x0200" type="Button">
        <Parent guid="HubitatVS" id="HubitatAdornmentContextMenuGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Publish on Save</ButtonText>
          <LocCanonicalName>.HubitatVS.TogglePublishOnSaveCommand</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="HubitatVS" id="HubitatContextMenuFlyout" priority="0x0100">
      <Parent guid="VSMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
    </CommandPlacement>
    <CommandPlacement guid="HubitatVS" id="HubitatAdornmentContextMenuGroup" priority="0x0100">
      <Parent guid="HubitatVS" id="HubitatContextMenuFlyout"/>
    </CommandPlacement>
    <CommandPlacement guid="HubitatVS" id="HubitatAdornmentCompareGroup" priority="0x0200">
      <Parent guid="HubitatVS" id="HubitatContextMenuFlyout"/>
    </CommandPlacement>
  </CommandPlacements>

  <VisibilityConstraints>
    <VisibilityItem guid="HubitatVS" id="HubitatContextMenuFlyout" context="SelectedGroovyFileContext"/>
    <VisibilityItem guid="HubitatVS" id="TogglePublishOnSaveCommand" context="GroovyEditorOpenContext"/>
  </VisibilityConstraints>

  <KeyBindings>
    <KeyBinding guid="HubitatVS" id="PublishToHubitatCommand" editor="guidVSStd97" key1="9" mod1="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="HubitatVS" value="{0899a45c-32a0-48cb-8627-4af2e2976fc3}">
      <IDSymbol name="HubitatMenuGroup" value="0x0001" />
      <IDSymbol name="HubitatWorkspaceContextMenuGroup" value="0x0002" />
      <IDSymbol name="ShowHubitatConnectionsToolWindowCommand" value="0x0102" />
      <IDSymbol name="PublishToHubitatCommand" value="0x0103" />
      <IDSymbol name="HubitatContextMenuFlyout" value="0x0104" />
      <IDSymbol name="CompareWithHubCommand" value="0x0106" />
      <IDSymbol name="HubitatAdornmentContextMenu" value="0x0107" />
      <IDSymbol name="HubitatAdornmentContextMenuGroup" value="0x0108" />
      <IDSymbol name="TogglePublishOnSaveCommand" value="0x0109" />
      <IDSymbol name="ReplaceWithHubVersionCommand" value="0x010A" />
      <IDSymbol name="HubitatAdornmentCompareGroup" value="0x010B" />
    </GuidSymbol>

    <GuidSymbol name="guidWorkspaceExplorerToolWindowPackageCmdSet" value="{cfb400f1-5c60-4f3c-856e-180d28def0b7}">
      <IDSymbol name="idmWSE_ContextMenu" value="0x0002"/>
    </GuidSymbol>

    <GuidSymbol name="Icons" value="{3b6d4b18-2382-4761-b792-00ea3526509b}">
      <IDSymbol name="Logo" value="1"/>
    </GuidSymbol>

    <GuidSymbol name="SelectedGroovyFileContext" value="{B2C2B6E1-9B7E-4C8E-9F1A-1C7A8B5D4E3F}" />
    <GuidSymbol name="GroovyEditorOpenContext" value="{0E95C18F-1C5F-45B7-A943-E8D55F92FD10}" />
  </Symbols>
</CommandTable>
